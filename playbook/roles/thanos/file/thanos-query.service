[Unit]
Description=Thanos Query
After=network.target

[Service]
User=root
Group=root
ExecStart=/usr/local/bin/thanos query \
    --http-address=0.0.0.0:10903 \
    --grpc-address=0.0.0.0:10904 \
    #--store=10.200.61.26:10901 \
    --store=10.200.61.27:10901 \
    #--store=10.200.61.26:10905 \
    --store=10.200.61.27:10905 \
    --query.replica-label=replica
Restart=always

[Install]
WantedBy=multi-user.target